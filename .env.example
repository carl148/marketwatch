# Kopiere diese Datei nach .env und trage deine Werte ein. .env niemals committen.

# API-Schlüssel von https://platform.claude.com (Pflicht für den Coach).
ANTHROPIC_API_KEY=

# Modell für den Coach. Standard: claude-opus-5-5 (beste Qualität).
# Günstiger: claude-sonnet-5-5 oder claude-haiku-4-5 (schneller, einfachere Antworten).
CLAUDE_MODEL=claude-opus-5-5

# Port des Servers.
PORT=3000

# Tageslimits für Coach-Fragen (0 = unbegrenzt). Schützen vor hohen Kosten.
DAILY_LIMIT_PER_DEVICE=30
DAILY_LIMIT_PER_IP=100
DAILY_LIMIT_GLOBAL=2000

# Optional: Zugangscodes für eine geschlossene Testphase, durch Komma getrennt.
# Leer lassen, damit alle den Coach nutzen können.
ACCESS_CODES=

# Anzahl Proxys vor der App, damit Limits pro IP richtig zählen (bei Render, Fly, Railway meist 1).
TRUST_PROXY=0

# Ab so vielen Fragen in einem Gespräch bittet die App, ein neues Gespräch zu starten.
MAX_TURNS_PER_CONVERSATION=30
